# Directory that contains runtime/webgpu-f16/ (the seven model files). Defaults to .data/models.
ARDY_MODEL_ROOT=

# Public prefix that contains runtime/webgpu-f16/, for a deployment that keeps the model in object
# storage. When it is set, the model route redirects to the bucket and ARDY_MODEL_ROOT is unused.
# The bucket must answer cross-origin GET requests from the site's origin.
ARDY_MODEL_BASE_URL=

# Optional: the exact text encoder service (upstream's Gradio API) for encode_motion_prompt.
# Without it the tool reports the encoder unreachable and the pinned prompts still work.
ARDY_TEXT_ENCODER_URL=
# Optional: user:password when the encoder service requires a login.
ARDY_TEXT_ENCODER_AUTH=
