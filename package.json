{
  "name": "ardy",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names app,text-encoder \"vp run dev:app\" \"vp run text-encoder\"",
    "dev:app": "vp dev",
    "export:upstream-oracle": "tsx scripts/export-upstream-neural-oracle.ts",
    "build": "vp build",
    "check": "vp check",
    "preview": "concurrently --kill-others --names app,text-encoder \"vp run preview:app\" \"vp run text-encoder\"",
    "preview:app": "vp preview",
    "prepare:assets": "tsx scripts/prepare-core-assets.ts",
    "trace:motion": "tsx scripts/trace-motion-scene.ts",
    "start": "concurrently --kill-others --names app,text-encoder \"vp run start:app\" \"vp run text-encoder\"",
    "start:app": "node .output/server/index.mjs",
    "test": "vp test run",
    "text-encoder": "HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 .runtime/ardy/.venv/bin/python .runtime/ardy/scripts/run_text_encoder_server.py --host 127.0.0.1 --port 9550 --device cpu --tmp-folder .runtime/text-encoder-output"
  },
