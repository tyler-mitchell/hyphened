{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": false,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@coretime/core": ["../../packages/core-time/src/index.ts"],
      "@coretime/editor": ["../../packages/core-time-editor/src/index.ts"],
      "@coretime/core/react": ["../../packages/core-time/src/react.ts"],
      "webgpu-engine": ["../../packages/webgpu-engine/src/index.ts"],
      "webgpu-engine/witness": ["../../packages/webgpu-engine/src/witness-engine.ts"]
    },
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["vite/client", "@webgpu/types", "node"]
  },
  "include": ["scripts", "src", "tests"]
}
